{
  "manifest_version": 3,
  "name": "Webtrh filtr",
  "version": "1.2.0",
  "description": "Na webtrh.cz schová inzeráty na prodej domén, ve výpisu Nový obsah a v chatu. Místo nich pak načte další příspěvky.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webtrh.cz/*",
        "https://www.webtrh.cz/*"
      ],
      "js": [
        "classify.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "options.html"
      ],
      "matches": [
        "https://webtrh.cz/*",
        "https://www.webtrh.cz/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "webtrh-filtr@local",
      "strict_min_version": "115.0"
    }
  }
}